[Unit]
Description=Leave local Devin host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/leave serve --workspace WORKSPACE_ID
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=WORKSPACE_PATH %h/.local/share/leave

[Install]
WantedBy=default.target
